# =====================================================
# DeVote Voting System - Environment Configuration
# =====================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to GitHub!
# =====================================================

# -----------------------------------------------------
# Ethereum / Hardhat Configuration (Sepolia Testnet)
# -----------------------------------------------------

# Sepolia RPC URL (get from Alchemy/Infura)
# Example: https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
SEPOLIA_RPC_URL=your_sepolia_rpc_url_here

# Deployer private key (64 hex characters, no 0x prefix)
# Generate a new wallet for development - NEVER use a wallet with significant funds
PRIVATE_KEY=your_private_key_here

# Etherscan API key for contract verification (optional)
# Get from https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# -----------------------------------------------------
# Deployed Contract Address
# -----------------------------------------------------
# After deploying to Sepolia, update this in devote-ui/src/config.js
# or set it here and reference it in your frontend build process
# CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

# -----------------------------------------------------
# Firebase Configuration (for Firestore backend)
# -----------------------------------------------------
# Get these values from Firebase Console > Project Settings > General > Your Apps
# These are safe to expose in client-side code but should still be kept in .env

# FIREBASE_API_KEY=your_firebase_api_key
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# FIREBASE_APP_ID=your_app_id

# -----------------------------------------------------
# Frontend Configuration (optional overrides)
# -----------------------------------------------------
# REACT_APP_CONTRACT_ADDRESS=0xYourDeployedContractAddressHere
# REACT_APP_NETWORK=sepolia

# -----------------------------------------------------
# Sauti Learn (multilingual voice-learning module)
# Optional. Off by default for the voting flow.
# See SAUTI_LEARN_RESEARCH.md and sauti-learn-service/README.md
# -----------------------------------------------------
# Enable the extra USSD option 6 / IVR menu 6 in ussd-gateway
# SAUTI_ENABLED=false
# URL of the standalone sauti-learn-service
# SAUTI_URL=http://localhost:5050
# Public base URL the Africa's Talking Record callback should hit
# SAUTI_CALLBACK_BASE=https://your-gateway.onrender.com