# Sauti Learn Service - Configuration (Kenyan English & Kiswahili)
PORT=5050
SAUTI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 1. Google Gemini (Best Kiswahili & multimodal audio) ───────────────────
# Get key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# ── 2. Groq (Ultra-fast Whisper ASR & LLM) ─────────────────────────────────
# Get key from https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ASR_MODEL=whisper-large-v3

# ── 3. OpenAI (Optional fallback) ──────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_VOICE=coral

# ── 4. Azure AI Speech (Optional) ──────────────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_STT_LOCALE_SW=sw-KE
AZURE_STT_LOCALE_EN=en-KE

# ── 5. ElevenLabs (Optional natural voice) ─────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Operational Guardrails ─────────────────────────────────────────────────
SAUTI_MAX_AUDIO_SECONDS=30
SAUTI_REQUEST_TIMEOUT_MS=12000
SAUTI_MAX_ANSWER_CHARS=350
