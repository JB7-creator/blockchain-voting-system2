# =====================================================
# Sauti Learn Service - Environment Configuration
# Copy to .env. EVERYTHING is optional: with no keys the
# service runs in OFFLINE FAQ MODE (curated bilingual
# lessons, English/Kiswahili) so demos always work.
# =====================================================

PORT=5050

# ── LLM "brain" (tried in order: Gemini -> Groq -> OpenCode -> OpenAI) ──
# Google Gemini - strongest Kiswahili support
# List live models: node list-models.js  (keys read from .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Groq - ultra-fast inference + Whisper ASR (multilingual EN/SW)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ASR_MODEL=whisper-large-v3
# OpenCode gateway - OpenAI-compatible, many models.
# List model IDs: curl https://opencode.ai/zen/v1/models -H "Authorization: Bearer <key>"
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=
# OpenAI - alternative / fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Speech-to-Text ───────────────────────────────────
# Google Cloud STT: supports WEBM/OGG(opus) + FLAC/LINEAR16, locales en-KE & sw-KE
GOOGLE_STT_API_KEY=
GOOGLE_STT_REGION=global
# OpenAI Whisper API: accepts webm/mp3/wav directly, good Swahili
# (reuses OPENAI_API_KEY above)

# Azure AI Speech (STT + TTS): verified locales en-KE, sw-KE
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_STT_LOCALE_EN=en-KE
AZURE_STT_LOCALE_SW=sw-KE

# ── Kikuyu sidecar (Python FastAPI, see README) ──────
# POST {SIDECAR_URL}/asr   {audioBase64, lang:"kik"}  -> {text}
# POST {SIDECAR_URL}/tts   {text, lang:"kik"}         -> {audioBase64, mime}
# POST {SIDECAR_URL}/translate {text, from, to}       -> {text}
# Leave empty -> Kikuyu gracefully falls back to Swahili.
SIDECAR_URL=

# ── Limits (safety rails) ────────────────────────────
SAUTI_MAX_AUDIO_SECONDS=30
SAUTI_REQUEST_TIMEOUT_MS=12000
SAUTI_MAX_ANSWER_CHARS=300

# ── Natural voices (all optional; used in this order) ──────
# ElevenLabs - most natural, and the ONLY way to get a natural Gikuyu voice:
# clone a Kikuyu speaker (1-5 min audio) in the dashboard, put the voice ID
# below, and the same voice speaks English/Kiswahili/Gikuyu.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# OpenAI TTS - natural multilingual fallback
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Browser origins allowed to call this service (comma-separated).
# "*" is fine for dev; set your real domains in production.
SAUTI_ALLOWED_ORIGINS=*
